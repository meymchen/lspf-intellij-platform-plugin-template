# Gradle caches, build output, and IntelliJ Platform sandboxes
.gradle/
build/
.intellijPlatform/

# Cargo build output; keep Cargo.lock for reproducible server builds
target/

# Local IntelliJ project state; shared run configurations live in .run/
.idea/
*.iml
*.ipr
*.iws
out/

# Local environment files; keep documented configuration examples
.env
.env.*
!.env.example
!.env.sample
!.env.template

# JVM crash reports and heap dumps
hs_err_pid*
replay_pid*
*.hprof

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
